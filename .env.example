# ============================================================================
# may_store 配置文件模板
# ============================================================================
# 使用方法:
#   1. 复制本文件: `cp .env.example .env`
#   2. 填入你自己的真实值
#   3. .env 已在 .gitignore 中,不会被提交
#
# 启动时:必填项缺失则进程直接 panic,不会用弱默认值
# ============================================================================

# ==================== 必填项(缺失则启动失败) ====================

# PostgreSQL 连接串
# 格式: postgres://<user>:<password>@<host>:<port>/<database>
# 推荐:为应用单独建一个非 superuser 账号,只授予本库读写权限
DATABASE_URL=postgres://maystore:CHANGE_ME@127.0.0.1:5432/may_store

# Redis 连接串
# 格式: redis://[:<password>@]<host>:<port>/<db>
REDIS_URL=redis://127.0.0.1:6379/0

# JWT 签名密钥(HS256)
# 生成方式: openssl rand -base64 48
# 长度要求: 至少 32 字符(代码启动时会校验,弱密钥直接 panic)
# ⚠️ 轮换密钥会让所有已签发 token 失效,需通知客户端重新登录
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48

# ==================== 微信小程序(可选) ====================
# 不配置则微信登录 / 模板消息功能不可用,但不影响其他模块
# 在微信公众平台 https://mp.weixin.qq.com 获取
WX_APP_ID=
WX_APP_SECRET=

# ==================== 七牛云对象存储(可选) ====================
# 不配置则头像/菜品图/足迹图上传功能不可用
# 在七牛云控制台 https://portal.qiniut.com 获取
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=may-store
# 存储区域:z0=华东/z1=华北/z2=华南/na0=北美/as0=东南亚
QINIU_REGION=z0
# 上传/下载域名(可留空,使用七牛默认域名)
QINIU_UPLOAD_HOST=
QINIU_CDN_DOMAIN=
# Upload Token 有效期(秒),默认 3600
QINIU_TOKEN_EXPIRE_S=3600

# ==================== 腾讯云 IM(可选,小游戏联机) ====================
# 不配置则 IM 联机模式不可用(WS 模式不受影响)
# 在腾讯云 IM 控制台 https://console.cloud.tencent.com/im 获取
TENCENT_IM_SDK_APP_ID=
TENCENT_IM_SECRET_KEY=

# ==================== WebSocket(可选) ====================
# 默认值已合理,生产可调
# WS_PORT=9832

# ==================== CORS(强烈建议生产显式设置) ====================
# 前端 origin 白名单(逗号分隔多个)
# 留空或设为 "*" 时 CORS 放行所有 origin,生产环境**严禁**这样配
# 小程序真机/预览通常带 Origin: https://servicewechat.com,服务端已默认放行
FRONTEND_ORIGIN=https://your-prod-domain.com

# ==================== 数据库连接池调优(可选) ====================
# 默认值已合理,生产可按压测结果微调
# DB_MAX_CONNECTIONS=20
# DB_MIN_CONNECTIONS=2
# DB_ACQUIRE_TIMEOUT_SECS=3
# DB_IDLE_TIMEOUT_SECS=600
# DB_MAX_LIFETIME_SECS=1800
