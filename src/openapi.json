        }
      },
      "put": {
        "tags": ["菜品"],
        "summary": "更新菜品",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "更新成功"}
        }
      },
      "delete": {
        "tags": ["菜品"],
        "summary": "删除菜品",
        "security": [{"cookie_auth": []}],
