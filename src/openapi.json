  "components": {
    "schemas": {
      "UserPublic": {
        "type": "object",
        "properties": {
          "user_id": {"type": "integer"},
          "username": {"type": "string"},
          "nick_name": {"type": "string"},
          "avatar": {"type": "string"},
          "role": {"type": "string", "enum": ["ORDERING", "RECEIVING", "ADMIN"]},
          "group_id": {"type": "integer"}
        }
      },
      "UserInfoResponse": {
        "type": "object",
        "properties": {
          "is_register": {"type": "boolean"},
          "user": {"$ref": "#/components/schemas/UserPublic"}
        }
      },
      "ProfileUpdateInput": {
        "type": "object",
        "properties": {
          "username": {"type": "string"},
          "nick_name": {"type": "string"},
          "avatar": {"type": "string"},
          "gender": {"type": "string"},
          "birthday": {"type": "string", "format": "date"},
          "new_password": {"type": "string"},
          "old_password": {"type": "string"},
          "new_username": {"type": "string"}
        }
      },
      "RoleSwitchInput": {
        "type": "object",
        "properties": {
          "role": {"type": "string", "enum": ["ORDERING", "RECEIVING", "ADMIN"]}
        }
      },
      "OrderCreateInput": {
        "type": "object",
        "properties": {
          "group_id": {"type": "integer"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "food_id": {"type": "integer"},
                "quantity": {"type": "integer"}
              }
            }
          },
          "remark": {"type": "string"},
          "goal_time": {"type": "string", "format": "date-time"}
        }
      },
      "OrderStatusUpdateInput": {
        "type": "object",
        "properties": {
          "order_id": {"type": "integer"},
          "status": {"type": "string"}
        }
      },
      "FoodCreateInput": {
        "type": "object",
        "properties": {
          "group_id": {"type": "integer"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "images": {"type": "string"},
          "price": {"type": "number"},
          "tags": {"type": "array", "items": {"type": "string"}}
        }
      },
      "WishCreateInput": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "content": {"type": "string"},
          "point_cost": {"type": "integer"},
          "images": {"type": "string"}
        }
      },
      "NewInvitationInput": {
        "type": "object",
        "properties": {
          "to_username": {"type": "string"}
        }
      },
      "ConfirmInvitationInput": {
        "type": "object",
        "properties": {
          "accept": {"type": "boolean"}
        }
      },
      "UnbindRequestInput": {
        "type": "object",
        "properties": {
          "reason": {"type": "string"}
        }
      },
      "BindUserDirectlyInput": {
        "type": "object",
        "properties": {
          "user_id": {"type": "integer"}
        }
      },
      "GroupUpdateInput": {
