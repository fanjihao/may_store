{
  "openapi": "3.0.3",
  "info": {
    "title": "May Store API",
    "version": "1.0.0",
    "description": "心愿菜单 RESTful API - 基于 FSD 架构的心愿订单系统"
  },
  "servers": [
    {
      "url": "http://localhost:9831",
      "description": "开发环境服务器"
    }
  ],
  "tags": [
    {"name": "认证", "description": "用户登录、注册"},
    {"name": "双人组", "description": "双人组建组、邀请、角色互换"},
    {"name": "订单", "description": "订单创建、状态管理、确认完成"},
    {"name": "心愿", "description": "心愿创建、协商、选择、反馈"},
    {"name": "厨房", "description": "主人家厨房、做客订单"},
    {"name": "管理", "description": "管理员接口"}
  ],
  "paths": {
    "/api/auth/wechat-login": {
      "post": {
        "tags": ["认证"],
        "summary": "微信登录",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "weixin_code": {"type": "string", "description": "微信授权码"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {"type": "string"},
                    "user": {"$ref": "#/components/schemas/UserPublic"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/groups": {
      "post": {
        "tags": ["双人组"],
        "summary": "创建双人组",
        "security": [{"cookie_auth": []}],
        "responses": {
          "201": {"description": "创建成功"}
        }
      }
    },
    "/api/groups/{group_id}": {
      "get": {
        "tags": ["双人组"],
        "summary": "获取双人组信息",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "group_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "双人组信息"}
        }
      }
    },
    "/api/groups/{group_id}/invite": {
      "post": {
        "tags": ["双人组"],
        "summary": "创建邀请",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "group_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "邀请已创建"}
        }
      }
    },
    "/api/groups/{group_id}/swap-role": {
      "post": {
        "tags": ["双人组"],
        "summary": "角色互换",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "group_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "互换成功"}
        }
      }
    },
    "/api/groups/{group_id}/settlement-check": {
      "get": {
        "tags": ["双人组"],
        "summary": "退出组前结清检查",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "group_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "结清检查结果"}
        }
      }
    },
    "/api/groups/{group_id}/foods": {
      "get": {
        "tags": ["双人组"],
        "summary": "菜品列表",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "group_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "菜品列表"}
        }
      }
    },
    "/api/groups/{group_id}/orders": {
      "post": {
        "tags": ["订单"],
        "summary": "创建订单",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "group_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/OrderCreateInput"}
            }
          }
        },
        "responses": {
          "201": {"description": "订单创建成功"}
        }
      }
    },
    "/api/kitchens/invitations/{invite_code}": {
      "get": {
        "tags": ["厨房"],
        "summary": "通过邀请链接访问主人家厨房",
        "parameters": [
          {"name": "invite_code", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "厨房信息"}
        }
      }
    },
    "/api/kitchens/invitations/{invite_code}/foods": {
      "get": {
        "tags": ["厨房"],
        "summary": "查看主人家厨房菜单",
        "parameters": [
          {"name": "invite_code", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "菜单列表"}
        }
      }
    },
    "/api/kitchens/invitations/{invite_code}/orders": {
      "post": {
        "tags": ["厨房"],
        "summary": "创建做客订单",
        "parameters": [
          {"name": "invite_code", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/OrderCreateInput"}
            }
          }
        },
        "responses": {
          "201": {"description": "订单创建成功"}
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": ["订单"],
        "summary": "聚合查询自己组订单和我发起的做客订单",
        "security": [{"cookie_auth": []}],
        "responses": {
          "200": {"description": "订单列表"}
        }
      }
    },
    "/api/orders/{order_id}": {
      "get": {
        "tags": ["订单"],
        "summary": "获取订单详情",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "order_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "订单详情"}
        }
      }
    },
    "/api/orders/{order_id}/accept": {
      "post": {
        "tags": ["订单"],
        "summary": "接单 - Seller 接受订单",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "order_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "接单成功"}
        }
      }
    },
    "/api/orders/{order_id}/complete": {
      "post": {
        "tags": ["订单"],
        "summary": "Seller 完成订单",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "order_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "完成成功"}
        }
      }
    },
    "/api/orders/{order_id}/confirm": {
      "post": {
        "tags": ["订单"],
        "summary": "Buyer 确认订单",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "order_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "isComplete": {"type": "boolean"},
                  "remark": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "确认成功"}
        }
      }
    },
    "/api/groups/{group_id}/wishes": {
      "post": {
        "tags": ["心愿"],
        "summary": "创建心愿",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "group_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/WishCreateInput"}
            }
          }
        },
        "responses": {
          "201": {"description": "创建成功"}
        }
      }
    },
    "/wishes": {
      "get": {
        "tags": ["心愿"],
        "summary": "获取心愿列表",
        "security": [{"cookie_auth": []}],
        "responses": {
          "200": {"description": "心愿列表"}
        }
      }
    },
    "/wishes/{id}": {
      "get": {
        "tags": ["心愿"],
        "summary": "获取心愿详情",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "心愿详情"}
        }
      },
      "put": {
        "tags": ["心愿"],
        "summary": "更新心愿",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "更新成功"}
        }
      },
      "delete": {
        "tags": ["心愿"],
        "summary": "删除心愿",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "删除成功"}
        }
      }
    },
    "/wishes/{id}/quote": {
      "post": {
        "tags": ["心愿"],
        "summary": "协商报价 - 发起人或履约人报价或还价",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cost": {"type": "integer", "description": "报价积分"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "报价成功"}
        }
      }
    },
    "/wishes/{id}/deadline": {
      "post": {
        "tags": ["心愿"],
        "summary": "协商履约期限 - 发起人或履约人设置履约期限",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deadlineHours": {"type": "integer", "description": "履约期限（小时）"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "设置成功"}
        }
      }
    },
    "/wishes/{id}/confirm-agreement": {
      "post": {
        "tags": ["心愿"],
        "summary": "双方线上确认积分和期限 - 心愿进入心愿池",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "确认成功，心愿进入心愿池"}
        }
      }
    },
    "/wishes/{id}/reject": {
      "post": {
        "tags": ["心愿"],
        "summary": "拒绝或关闭协商",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {"type": "string", "description": "关闭原因"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "操作成功"}
        }
      }
    },
    "/wishes/{id}/select": {
      "post": {
        "tags": ["心愿"],
        "summary": "选择心愿并冻结积分 - 发起人选择心愿，冻结其爱心积分",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "选择成功，积分已冻结"}
        }
      }
    },
    "/wishes/{id}/feedback": {
      "put": {
        "tags": ["心愿"],
        "summary": "发起人提交打卡反馈",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {"type": "string"},
                  "images": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "反馈成功"}
        }
      }
    },
    "/api/groups/{group_id}/fulfillment-stats": {
      "get": {
        "tags": ["双人组"],
        "summary": "查看组内双方履约统计",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "group_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "履约统计"}
        }
      }
    },
    "/api/admin/wishes/{wish_id}/quality-reward": {
      "post": {
        "tags": ["管理"],
        "summary": "管理员按反馈质量发放额外组钻石",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "wish_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "qualityLevel": {"type": "string", "enum": ["NONE", "NORMAL", "GOOD", "EXCELLENT"]},
                  "remark": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "奖励成功"}
        }
      }
    },
    "/api/admin/orders/{order_id}/reward-review": {
      "post": {
        "tags": ["管理"],
        "summary": "管理员审核风险订单积分和经验发放",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "order_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "approvePoint": {"type": "boolean"},
                  "approveExp": {"type": "boolean"},
                  "remark": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "审核成功"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserPublic": {
        "type": "object",
        "properties": {
          "user_id": {"type": "integer"},
          "username": {"type": "string"},
          "nick_name": {"type": "string"},
          "avatar": {"type": "string"},
          "role": {"type": "string", "enum": ["BUYER", "SELLER"]},
          "group_id": {"type": "integer"}
        }
      },
      "OrderCreateInput": {
        "type": "object",
        "properties": {
          "group_id": {"type": "integer"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "food_id": {"type": "integer"},
                "quantity": {"type": "integer"}
              }
            }
          },
          "remark": {"type": "string"},
          "goal_time": {"type": "string", "format": "date-time"}
        }
      },
      "WishCreateInput": {
        "type": "object",
        "properties": {
          "wishName": {"type": "string"},
          "wishCost": {"type": "integer"},
          "groupId": {"type": "integer"}
        }
      }
    },
    "securitySchemes": {
      "cookie_auth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token"
      }
    }
  }
}