{
  "openapi": "3.0.3",
  "info": {
    "title": "May Store API",
    "version": "1.0.0",
    "description": "心愿菜单 RESTful API - 基于 FSD 架构的心愿订单系统"
  },
  "servers": [
    {
      "url": "http://localhost:9831",
      "description": "开发环境服务器"
    }
  ],
  "tags": [
    {"name": "用户", "description": "用户注册、登录、资料管理"},
    {"name": "订单", "description": "订单创建、状态管理、评价"},
    {"name": "签到", "description": "每日签到、连续签到奖励"},
    {"name": "足迹", "description": "用户足迹记录、相册管理"},
    {"name": "菜品", "description": "菜品管理、标签、食材"},
    {"name": "心愿", "description": "心愿创建、心愿池、心愿兑换"},
    {"name": "数据看板", "description": "订单统计、积分旅程"},
    {"name": "通知", "description": "消息推送、系统通知"},
    {"name": "情侣空间", "description": "纪念日管理"},
    {"name": "上传", "description": "文件上传、资源管理"},
    {"name": "管理", "description": "后台管理、运营配置"}
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["用户"],
        "summary": "用户登录",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {"type": "string"},
                  "password": {"type": "string"},
                  "weixin_code": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {"type": "string"},
                    "user": {"$ref": "#/components/schemas/UserPublic"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["用户"],
        "summary": "用户注册",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {"type": "string"},
                  "password": {"type": "string"},
                  "email": {"type": "string"},
                  "phone": {"type": "string"},
                  "avatar": {"type": "string"},
                  "open_id": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "注册成功"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["用户"],
        "summary": "获取当前用户信息",
        "security": [{"cookie_auth": []}],
        "responses": {
          "200": {
            "description": "用户信息",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/UserPublic"}
              }
            }
          }
        }
      }
    },
    "/users/info": {
      "get": {
        "tags": ["用户"],
        "summary": "根据用户名获取用户信息",
        "parameters": [
          {"name": "username", "in": "query", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "用户信息",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/UserInfoResponse"}
              }
            }
          }
        }
      }
    },
    "/users/check-register": {
      "get": {
        "tags": ["用户"],
        "summary": "检查用户名是否已注册",
        "parameters": [
          {"name": "username", "in": "query", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "注册状态"
          }
        }
      }
    },
    "/users/profile": {
      "put": {
        "tags": ["用户"],
        "summary": "修改用户信息",
        "security": [{"cookie_auth": []}],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ProfileUpdateInput"}
            }
          }
        },
        "responses": {
          "200": {"description": "更新成功"}
        }
      }
    },
    "/users/role-switch": {
      "post": {
        "tags": ["用户"],
        "summary": "切换用户角色",
        "security": [{"cookie_auth": []}],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/RoleSwitchInput"}
            }
          }
        },
        "responses": {
          "200": {"description": "切换成功"}
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["订单"],
        "summary": "获取订单列表",
        "security": [{"cookie_auth": []}],
        "responses": {
          "200": {"description": "订单列表"}
        }
      },
      "post": {
        "tags": ["订单"],
        "summary": "创建订单",
        "security": [{"cookie_auth": []}],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/OrderCreateInput"}
            }
          }
        },
        "responses": {
          "201": {"description": "订单创建成功"}
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": ["订单"],
        "summary": "获取订单详情",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "订单详情"}
        }
      },
      "delete": {
        "tags": ["订单"],
        "summary": "删除订单",
        "security": [{"cookie_auth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "删除成功"}
        }
      }
    },
    "/orders/team-today": {
      "get": {
        "tags": ["订单"],
        "summary": "获取团队今日订单",
